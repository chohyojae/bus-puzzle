{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/test-results",
      "!**/playwright-report",
      "!**/.playwright-mcp",
      "!DEVELOPMENT_PLAN.md"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "css": { "linter": { "enabled": false } }
}
